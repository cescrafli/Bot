{
  "name": "celyn-ai-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Chatbot dengan Avatar Bergerak (2D & 3D VRM) + Live Screen Share + Gemini Live API",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@libsql/client": "^0.18.0",
    "busboy": "^1.6.0",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "file-type": "^22.2.0",
    "mammoth": "^1.13.0",
    "pdfmake": "^0.3.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^2.0.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev:server": "npm --workspace=apps/server run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev": "node scripts/dev-all.mjs",
    "test:poc": "tsx scripts/test-poc-vision.ts",
    "test:pipeline": "tsx scripts/test-pipeline.ts",
    "db:check": "tsx scripts/inspect-database.ts",
    "build": "npm --workspaces run build"
  },
  "keywords": [
    "ai",
    "gemini",
    "avatar",
    "vrm",
    "screen-share",
    "live-api"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/pdfmake": "^0.3.3",
    "@types/turndown": "^5.0.6"
  }
