{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm --workspace=packages/shared run build && npm --workspace=apps/web run build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "functions": {
    "api/documents-read.js": {
      "maxDuration": 60
    },
    "api/documents-generate.js": {
      "maxDuration": 60
    },
    "api/documents-process.js": {
      "maxDuration": 60
    },
    "api/documents-upload-url.js": {
      "maxDuration": 60
    },
    "api/documents-extract-file.js": {
      "maxDuration": 60
    },
    "api/research.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/verify",
      "destination": "/api/auth-verify"
    },
    {
      "source": "/api/memory/remember",
      "destination": "/api/remember"
    },
    {
      "source": "/api/documents/upload-url",
      "destination": "/api/documents-upload-url"
    },
    {
      "source": "/api/documents/extract-file",
      "destination": "/api/documents-extract-file"
    },
    {
      "source": "/api/documents/read",
      "destination": "/api/documents-read"
    },
    {
      "source": "/api/documents/upload",
      "destination": "/api/documents-read"
    },
    {
      "source": "/api/documents/process",
      "destination": "/api/documents-process"
    },
    {
      "source": "/api/documents/generate",
      "destination": "/api/documents-generate"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
