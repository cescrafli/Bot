# Google Gemini API Key (Dapatkan di https://aistudio.google.com/)
# Dukungan multi-key rotasi otomatis (pisahkan dengan koma) untuk mencegah batas kuota 429
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key_1_here,key_2_here

# Backend Server Port (Untuk Local WebSocket Server mode)
PORT=3001

# Autentikasi Kredensial & Sesi Token HMAC
ADMIN_PASSWORD=admin
USER_PASSWORD=login
AUTH_SECRET=your_32_character_secret_salt_here

# Gemini Multimodal Live API Model (Wajib gemini-3.8-live untuk protokol Live Direct WebSocket)
GEMINI_MODEL=gemini-3.8-live

# Model Pemrosesan Riset Web & Pencarian Grounding
RESEARCH_MODEL=gemini-3.8-flash

# Model Pemrosesan Teks & Memori
TEXT_MODEL=gemini-3.8-flash

# Suara Celyn (Gemini Live Native Ultra-Natural: Aoede / Kore)
GEMINI_VOICE=Aoede

# Turso Cloud Database (Long-Term Memory Storage)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Fitur Dokumen (PDF, Excel, Word)
DOC_MAX_UPLOAD_MB=4
DOC_OCR_MODEL=gemini-3.8-flash
DOC_GENERATE_MODEL=gemini-3.8-flash
DOC_MAX_CONTEXT_CHARS=60000
